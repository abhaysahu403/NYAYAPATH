# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=demo-secret-change-me-to-a-long-random-string-0123456789abcdef
DEBUG=False
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost

# ---- PostgreSQL (pgvector extension required) ----
DATABASE_URL=postgres://nyaya:nyaya@localhost:5432/nyayapath
# or: DB_NAME / DB_USER / DB_PASSWORD / DB_HOST / DB_PORT

# ---- AI provider: mock (offline, deterministic) | gemini ----
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# ---- AI cost control ----
AI_MAX_INPUT_CHARS=3000
AI_MAX_OUTPUT_TOKENS=2048
RETRIEVAL_TOP_K=5
AI_CACHE_TTL_SECONDS=3600

# ---- Rate limits (DRF format: N/second|minute|hour|day) ----
THROTTLE_AI_CHAT=60/hour
THROTTLE_AI_GUEST=10/hour
THROTTLE_AI_DOCUMENTS=30/hour
THROTTLE_JUDGMENT_SEARCH=120/hour
THROTTLE_AUTH=20/hour

# ---- Uploads / private storage ----
MAX_UPLOAD_SIZE_MB=20
PRIVATE_MEDIA_ROOT=./private_media
DOCUMENT_PROCESSING_MODE=sync
# Optional S3-compatible storage (production)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=

# ---- Optional ----
REDIS_URL=
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password?uid={uid}&token={token}
LOG_LEVEL=INFO
